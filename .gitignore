# ==========================================
# Monorepo .gitignore — Marvinno Technologies
# ==========================================

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies — both frontend & backend
node_modules
**/node_modules

# Frontend build output
/dist
frontend/dist
frontend/dist-ssr
frontend/build
*.local

# Backend build output
backend/dist

# Environment files — NEVER commit these
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.production
**/.env.development

# Testing
/coverage
**/coverage

# Legacy/ignored dirs from old structure
/build
/ignore
/Marvino
.VSCodeCounter
.vscode

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
