# ============================
# Marvinno Backend Environment Template
# ============================
# Copy this file to .env and fill in your actual values — NEVER commit .env

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.XXXXX.mongodb.net/marvinno?retryWrites=true&w=majority

# Secret key used to sign JWT login tokens
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Official Frontend Domain for CORS whitelist
FRONTEND_URL=https://marvinno.in

# SMTP Email setup (Gmail Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info.marvinno@gmail.com
SMTP_PASS=your_gmail_app_password_here
EMAIL_FROM=Marvinno Technologies <info.marvinno@gmail.com>
